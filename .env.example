# datapai-stock-be environment variables

# Platform framework location
DATAPAI_PLATFORM_DIR=/home/ec2-user/git/vanna-streamlit

# PostgreSQL (shared with platform)
DATAPAI_PG_HOST=localhost
DATAPAI_PG_PORT=5432
DATAPAI_PG_DB=postgres
DATAPAI_PG_USER=postgres
DATAPAI_PG_PASSWORD=postgres

# LLM Configuration
DATAPAI_LLM_ENABLED=true
LLM_MODE=paid
LLM_PRIMARY_PROVIDER=openai
LLM_SECONDARY_PROVIDER=google

# API auth
TINYFISH_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-4.5-sonnet
BEDROCK_REGION=ap-southeast-2

# Cost guard
COST_GUARD_ENABLED=true
DAILY_LLM_BUDGET_USD=5.00
