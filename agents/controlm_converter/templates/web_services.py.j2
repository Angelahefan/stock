# {{ job._name }} — Control-M Web Services / REST job
{{ task_id }} = HttpOperator(
    task_id="{{ task_id }}",
    http_conn_id="{{ fields.connection | default('http_default') }}",
    endpoint="{{ fields.url | default('/TODO') }}",
    method="{{ fields.method | default('POST') }}",
    headers={{ fields.headers | default({}) | tojson }},
    data={{ fields.body | default(None) | tojson }},
    log_response=True,
)
