# {{ job._name }} — Control-M FileTransfer ({{ fields.protocol | default("sftp") }})
{{ task_id }} = SFTPOperator(
    task_id="{{ task_id }}",
    ssh_conn_id="{{ fields.dest_host | default('TODO_sftp_conn_id') }}",
    local_filepath="{{ fields.source_path | default('/TODO/source') }}",
    remote_filepath="{{ fields.dest_path | default('/TODO/dest') }}",
    operation="put",
    create_intermediate_dirs=True,
)
