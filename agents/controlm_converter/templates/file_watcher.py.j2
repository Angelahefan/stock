# {{ job._name }} — Control-M FileWatcher
{% set path = fields.path | default(job.Path) | default("/tmp/TODO") %}
{% if path.startswith("s3://") %}
from airflow.providers.amazon.aws.sensors.s3 import S3KeySensor  # noqa: E402
{{ task_id }} = S3KeySensor(
    task_id="{{ task_id }}",
    bucket_key="{{ path }}",
    poke_interval=30,
    timeout={{ fields.timeout | default(3600) }},
)
{% else %}
{{ task_id }} = FileSensor(
    task_id="{{ task_id }}",
    filepath="{{ path }}",
    poke_interval=30,
    timeout={{ fields.timeout | default(3600) }},
    mode="reschedule",
)
{% endif %}
