# {{ job._name }} — Control-M Python job
{% if fields.module and fields.callable %}
from {{ fields.module }} import {{ fields.callable }} as _{{ task_id }}_fn  # noqa: E402
{{ task_id }} = PythonOperator(
    task_id="{{ task_id }}",
    python_callable=_{{ task_id }}_fn,
    op_args={{ fields.args | default([]) | tojson }},
)
{% else %}
{{ task_id }} = BashOperator(
    task_id="{{ task_id }}",
    bash_command="python {{ fields.script | default('/TODO/script.py') }} {{ fields.args | default([]) | join(' ') }}",
)
{% endif %}
